# Bot account's phone number, digits only with country code (no +). Used for the pairing code.
# Leave empty to link with a QR code instead.
WA_PHONE_NUMBER=31612345678

# JID of the group to track (ends with @g.us). Start the bot once; it logs all groups with their JIDs.
WA_GROUP_JID=

# Daily leaderboard time and timezone
LEADERBOARD_TIME=22:00
TIMEZONE=Europe/Amsterdam

# Players who scored within this many days are listed under "not played yet"
ACTIVE_PLAYER_DAYS=14

# Print messages instead of sending them (same as --dry-run)
DRY_RUN=false

LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

# Paths (defaults shown)
AUTH_DIR=./auth
DB_PATH=./data/scores.db
CONFIG_PATH=./config.json

# Optional: one dry joke about the daily winner (only scores are sent, never names or chat)
ENABLE_JOKES=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
